# ==================================================
# GraphRAG 环境变量模板
# 用法: 复制为 .env 并填入真实值; .env 已被 .gitignore 排除, 严禁入库
# ==================================================

# --- 模型 API 密钥 (config/models.yaml 的 api_key_ref 指向此处) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key
LOCAL_KEY=ollama-local-placeholder

# --- JWT (业务面签发 + langgraph-server custom auth 共享同一 secret) ---
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 生产必须 ≥32 字节随机值，否则启动 fail-fast（D7/J16，详见 app/core/config.py validate_prod_secrets）
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
ENV=dev                         # dev|prod：非 dev 时启用生产强校验（P0-01）
ADMIN_PASSWORD=change-me-strong-password
VALID_API_KEYS=prod-api-key-1,prod-api-key-2

# --- Web 搜索 (J4 双轨: Tavily 主, 无 Key 自动降级 DuckDuckGo) ---
TAVILY_API_KEY=tvly-your-tavily-key

# --- 基础设施连接 ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379
ELASTICSEARCH_HOST=http://localhost:9200
POSTGRES_DSN=postgresql://graphrag:graphrag@localhost:5433/graphrag   # J21 thread checkpoint
DATABASE_URI=postgresql://graphrag:graphrag@localhost:5433/graphrag   # langgraph-server checkpoint 库（10.3，与 compose postgres 服务对齐）

# --- 应用 ---
DEBUG_ENABLED=true                                                   # dev 开启 /admin/debug/* 调试端点（fail-closed：生产置 false 或删除）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]       # Vite dev 白名单, 生产收紧
LANGCHAIN_TRACING_V2=true                                            # LangSmith; 若用 Langfuse 自托管则改接其 OTEL 变量
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graphrag
